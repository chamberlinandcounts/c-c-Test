# Copy to .env (scripts/setup-env.sh does this and generates the secrets).
POSTGRES_DB=canyon_oaks
POSTGRES_USER=canyon
POSTGRES_PASSWORD=change-me
# Staff token for the Issue Tracker (status edits, reporter details). 32+ random chars.
ADMIN_TOKEN=change-me
# Local port for the single published service (always bound to 127.0.0.1).
WEB_PORT=8080
# Max issue submissions per client IP per hour (0 = unlimited).
RATE_LIMIT_PER_HOUR=10
# Email notifications: OFF by default. Set EMAIL_ENABLED=true only once SMTP creds exist.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_STAFF_TO=
EMAIL_CONFIRM_REPORTER=false
